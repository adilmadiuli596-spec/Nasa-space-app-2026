# Server-only settings. Never put real secrets in this file or chat.
EARTH_MODE=blocked
# blocked (default), demo (two preloaded real cells), local (loopback only, never Vercel).
# Use npm run nasa:local for hidden token entry; no token file is required.
EARTHDATA_TOKEN=
EARTH_CACHE=memory
# Optional local-only file cache: EARTH_CACHE=file, fixed .cache/nasa-n3 directory.
# N4A geocoding: photon (manual, fair use) or off; no key required.
EARTH_GEOCODING=photon
