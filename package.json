{
  "name": "earth-detective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run boundaries && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "probe:nasa": "tsx --conditions=react-server scripts/probe-nasa.ts",
    "probe:hdf5": "tsx scripts/probe-hdf5.ts",
    "verify:server-only": "node scripts/verify-server-only.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "prebuild": "node scripts/prepare-maplibre.mjs",
    "predev": "node scripts/prepare-maplibre.mjs",
    "nasa:local": "node scripts/local-nasa.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.18.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "h5wasm": "0.10.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
